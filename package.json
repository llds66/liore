{
  "name": "liore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "windows:dev": "tauri dev",
    "build": "pnpm typecheck && vite build",
    "build:windows": "tauri build --no-bundle",
    "build:windows:installer": "tauri build --bundles nsis",
    "lint": "oxlint --vue-plugin .",
    "lint:fix": "oxlint --vue-plugin . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "@tauri-apps/api": "^2",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
