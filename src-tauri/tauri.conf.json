{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liore",
  "version": "0.2.1",
  "identifier": "com.lldsss.liore",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liore",
        "decorations": false,
        "visible": false,
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTUxMkUxQkI5REZEQkEKUldTNi9aMjc0UkpWSG5meXBqaW9yMzRqQm5XZDRmSGwwWnVRc1ZacU1tTklZRVJoVy9uSGorazYK",
      "endpoints": ["https://github.com/llds66/liore/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
